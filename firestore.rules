rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Helper function to check if user has Administrador role
    function isAdministrador() {
      return isAuthenticated() && (
        getUserData().rol == 'Administrador' ||
        request.auth.token.rol == 'Administrador'
      );
    }

    // Helper function to check if user has Analista role
    function isAnalista() {
      return isAuthenticated() && (
        getUserData().rol == 'Analista' ||
        request.auth.token.rol == 'Analista'
      );
    }

    // ========================================================
    // COLECCIÓN: clientes (Tabla Principal: CLIENTES)
    // ========================================================
    // ID del documento: numero_orden (RN01)
    // Permite lectura a cualquier usuario autenticado (Admin, Analista, Consulta).
    // Permite creación/actualización a Administrador y Analista (para actualizar ultima_gestion).
    match /clientes/{numero_orden} {
      allow read: if isAuthenticated();
      allow create: if isAdministrador() || isAnalista();
      allow update: if isAdministrador() || isAnalista();
      allow delete: if isAdministrador();
    }

    // ========================================================
    // COLECCIÓN: gestiones (Tabla de Histórico e Inmutabilidad)
    // ========================================================
    // RN02: 1 Cliente = Muchas Gestiones, cada una con ID autogenerado.
    // RN03 & RN08: INMUTABILIDAD ESTRICTA. Jamás se permite editar ni borrar.
    match /gestiones/{id_gestion} {
      allow read: if isAuthenticated();
      allow create: if isAdministrador() || isAnalista();
      // BLOQUEO ESTRICTO A NIVEL DE MOTOR DE BASE DE DATOS
      allow update, delete: if false;
    }

    // ========================================================
    // COLECCIÓN: bitacora_auditoria (Trazabilidad y RN11)
    // ========================================================
    // Solo lectura y registro nuevo; jamás edición ni eliminación.
    match /bitacora_auditoria/{id_auditoria} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========================================================
    // COLECCIÓN: catalogos (Administración de Catálogos)
    // ========================================================
    // Todos leen, pero solo Administrador puede modificar los catálogos.
    match /catalogos/{catalogoId} {
      allow read: if isAuthenticated();
      allow write: if isAdministrador();
    }

    // ========================================================
    // COLECCIÓN: usuarios (Gestión de Perfiles y Roles)
    // ========================================================
    // Solo el Administrador puede crear o actualizar usuarios.
    // Cada usuario puede leer su propio perfil.
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdministrador();
    }
  }
}
