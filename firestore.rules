rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validar que la solicitud provenga de un usuario autenticado en Firebase
    function isAuthenticated() {
      return request.auth != null;
    }

    // ========================================================
    // COLECCIÓN: clientes (Tabla Principal: CLIENTES)
    // ========================================================
    // Permite lectura y escritura a usuarios autenticados
    match /clientes/{numero_orden} {
      allow read, write: if isAuthenticated();
    }

    // ========================================================
    // COLECCIÓN: gestiones (Histórico de Gestiones)
    // ========================================================
    // RN02, RN03 & RN08: Inmutabilidad estricta. Jamás editar ni eliminar.
    match /gestiones/{id_gestion} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========================================================
    // COLECCIÓN: bitacora_auditoria (Trazabilidad y RN11)
    // ========================================================
    // Solo lectura y registro nuevo; jamás edición ni eliminación.
    match /bitacora_auditoria/{id_auditoria} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========================================================
    // COLECCIÓN: catalogos (Administración de Catálogos Dinámicos)
    // ========================================================
    match /catalogos/{catalogoId} {
      allow read, write: if isAuthenticated();
    }

    // ========================================================
    // COLECCIÓN: usuarios (Gestión y Sincronización de Usuarios)
    // ========================================================
    match /usuarios/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
